#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define INF 99999999

int findCheapestPrice(int n, int** flights, int flightsSize, int* flightsColSize, int src, int dst, int k) {
    int i, j;
    int u, v, w;
    int result;

    int* dist = (int*)malloc(n * sizeof(int));
    int* temp_dist = (int*)malloc(n * sizeof(int));

    for (i = 0; i < n; i++) {
        dist[i] = INF;
    }
    dist[src] = 0;

    for (i = 0; i <= k; i++) {
        for (j = 0; j < n; j++) {
            temp_dist[j] = dist[j];
        }

        for (j = 0; j < flightsSize; j++) {
            u = flights[j][0];
            v = flights[j][1];
            w = flights[j][2];

            if (dist[u] != INF && dist[u] + w < temp_dist[v]) {
                temp_dist[v] = dist[u] + w;
            }
        }

        for (j = 0; j < n; j++) {
            dist[j] = temp_dist[j];
        }
    }

    result = dist[dst];

    free(dist);
    free(temp_dist);

    if (result == INF) {
        return -1;
    }

    return result;
}
