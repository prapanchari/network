#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

struct Edge {
    int to;
    int cost;
    struct Edge* next;
};

struct Edge** head;
bool* visited;
int total_changes;

void addEdge(int u, int v, int cost) {
    struct Edge* newEdge = (struct Edge*)malloc(sizeof(struct Edge));
    newEdge->to = v;
    newEdge->cost = cost;
    newEdge->next = head[u];
    head[u] = newEdge;
}

void dfs(int node) {
    struct Edge* curr;
    visited[node] = true;
    curr = head[node];

    while (curr != NULL) {
        if (!visited[curr->to]) {
            total_changes += curr->cost;
            dfs(curr->to);
        }
        curr = curr->next;
    }
}

int minReorder(int n, int** connections, int connectionsSize, int* connectionsColSize) {
    int i;
    int u, v;
    struct Edge* curr;
    struct Edge* nextNode;

    head = (struct Edge**)malloc(n * sizeof(struct Edge*));
    visited = (bool*)malloc(n * sizeof(bool));
    total_changes = 0;

    for (i = 0; i < n; i++) {
        head[i] = NULL;
        visited[i] = false;
    }

    for (i = 0; i < connectionsSize; i++) {
        u = connections[i][0];
        v = connections[i][1];
        addEdge(u, v, 1); 
        addEdge(v, u, 0); 
    }

    dfs(0);

    for (i = 0; i < n; i++) {
        curr = head[i];
        while (curr != NULL) {
            nextNode = curr->next;
            free(curr);
            curr = nextNode;
        }
    }
    free(head);
    free(visited);

    return total_changes;
}
