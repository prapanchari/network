#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

#define INF 999999

int networkDelayTime(int** times, int timesSize, int* timesColSize, int n, int k) {
    int i, count, u, v, w;
    int max_time = 0;
    
    int* dist = (int*)malloc((n + 1) * sizeof(int));
    bool* visited = (bool*)malloc((n + 1) * sizeof(bool));
    int** graph = (int**)malloc((n + 1) * sizeof(int*));
    
    for (i = 1; i <= n; i++) {
        graph[i] = (int*)malloc((n + 1) * sizeof(int));
        dist[i] = INF;
        visited[i] = false;
        for (int j = 1; j <= n; j++) {
            graph[i][j] = (i == j) ? 0 : INF;
        }
    }
    
    for (i = 0; i < timesSize; i++) {
        u = times[i][0];
        v = times[i][1];
        w = times[i][2];
        graph[u][v] = w;
    }
    
    dist[k] = 0;
    
    for (count = 1; count <= n; count++) {
        int min_dist = INF;
        int min_node = -1;
        
        for (i = 1; i <= n; i++) {
            if (!visited[i] && dist[i] < min_dist) {
                min_dist = dist[i];
                min_node = i;
            }
        }
        
        if (min_node == -1) break;
        visited[min_node] = true;
        
        for (v = 1; v <= n; v++) {
            if (!visited[v] && graph[min_node][v] != INF && dist[min_node] + graph[min_node][v] < dist[v]) {
                dist[v] = dist[min_node] + graph[min_node][v];
            }
        }
    }
    
    for (i = 1; i <= n; i++) {
        if (dist[i] == INF) {
            max_time = -1;
            break;
        }
        if (dist[i] > max_time) {
            max_time = dist[i];
        }
    }
    
    for (i = 1; i <= n; i++) {
        free(graph[i]);
    }
    free(graph);
    free(dist);
    free(visited);
    
    return max_time;
}
