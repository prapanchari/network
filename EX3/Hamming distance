#include <stdio.h>

#define MAX_BITS 100

int main() {
    int d; 
    int p = 0;
    int total_len;
    int data_idx;
    int parity_pos;
    int parity_val;
    int parity_check;
    int error_pos;
    int i, j; 

    int data[MAX_BITS];
    int code[MAX_BITS];
    int received[MAX_BITS];

    printf("Enter the number of data bits: ");
    if (scanf("%d", &d) != 1 || d <= 0 || d >= MAX_BITS / 2) {
        printf("Invalid number of bits.\n");
        return 1;
    }

    while ((1 << p) < (d + p + 1)) {
        p++;
    }
    total_len = d + p;
    printf("Number of parity bits needed: %d\n", p);
    printf("Total frame length: %d bits\n\n", total_len);

    printf("Enter the %d data bits (0 or 1, separated by spaces): ", d);
    for (i = d; i >= 1; i--) {
        scanf("%d", &data[i]);
    }

    data_idx = 1;
    for (i = 1; i <= total_len; i++) {
        if ((i & (i - 1)) == 0) {
            code[i] = 0; 
        } else {
            code[i] = data[data_idx++];
        }
    }

    for (i = 0; i < p; i++) {
        parity_pos = 1 << i; 
        parity_val = 0;
        for (j = 1; j <= total_len; j++) {
            if ((j & parity_pos) != 0 && j != parity_pos) {
                parity_val ^= code[j];
            }
        }
        code[parity_pos] = parity_val;
    }

    printf("\nEncoded Hamming Code sent: ");
    for (i = total_len; i >= 1; i--) {
        printf("%d ", code[i]);
    }
    printf("\n");

    printf("\nEnter the received bits (simulated with or without an error): ");
    for (i = total_len; i >= 1; i--) {
        scanf("%d", &received[i]);
    }

    error_pos = 0;
    for (i = 0; i < p; i++) {
        parity_pos = 1 << i;
        parity_check = 0;
        for (j = 1; j <= total_len; j++) {
            if ((j & parity_pos) != 0) {
                parity_check ^= received[j];
            }
        }
        if (parity_check != 0) {
            error_pos += parity_pos;
        }
    }

    if (error_pos == 0) {
        printf("\nNo error detected!\n");
    } else if (error_pos <= total_len) {
        printf("\nError detected at bit position: %d\n", error_pos);
        received[error_pos] = !received[error_pos]; 
        
        printf("Corrected Hamming Code: ");
        for (i = total_len; i >= 1; i--) {
            printf("%d ", received[i]);
        }
        printf("\n");
    } else {
        printf("\nMultiple errors detected (cannot be corrected).\n");
        return 1;
    }

    printf("Final Data Bits extracted: ");
    for (i = total_len; i >= 1; i--) {
        if ((i & (i - 1)) != 0) {
            printf("%d ", received[i]);
        }
    }
    printf("\n");

    return 0;
}
