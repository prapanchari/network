#include <stdio.h>

void solve() {
    char s[1005];
    int sum = 0;
    int i = 0;
    
    if (scanf("%s", s) != 1) {
        return;
    }
    
    while (s[i] != '\0') {
        if (s[i] >= '0' && s[i] <= '9') {
            sum += (s[i] - '0');
        }
        i++;
    }
    
    printf("%d\n", sum);
}

int main() {
    int t;
    

    if (scanf("%d", &t) == 1) {
        while (t--) {
            solve();
        }
    }
    return 0;
}
