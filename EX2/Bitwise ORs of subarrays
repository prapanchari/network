#include <stdlib.h>

int subarrayBitwiseORs(int* arr, int arrSize) {
    if (arrSize == 0) return 0;
    
    int* ans = (int*)malloc(32 * arrSize * sizeof(int));
    int ansSize = 0;
    
    int* cur = (int*)malloc(32 * sizeof(int));
    int curSize = 0;
    
    for (int i = 0; i < arrSize; i++) {
        int* next = (int*)malloc(32 * sizeof(int));
        int nextSize = 0;
        
        next[nextSize++] = arr[i];
        
        for (int j = 0; j < curSize; j++) {
            int val = cur[j] | arr[i];
            int dup = 0;
            for (int k = 0; k < nextSize; k++) {
                if (next[k] == val) {
                    dup = 1;
                    break;
                }
            }
            if (!dup) {
                next[nextSize++] = val;
            }
        }
        
        free(cur);
        cur = next;
        curSize = nextSize;
        
        for (int j = 0; j < curSize; j++) {
            int val = cur[j];
            int dup = 0;
            for (int k = 0; k < ansSize; k++) {
                if (ans[k] == val) {
                    dup = 1;
                    break;
                }
            }
            if (!dup) {
                ans[ansSize++] = val;
            }
        }
    }
    
    free(cur);
    free(ans);
    return ansSize;
}
