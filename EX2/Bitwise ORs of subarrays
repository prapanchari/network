#include <stdlib.h>

int cmp(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

int subarrayBitwiseORs(int* arr, int arrSize) {
    if (arrSize == 0) return 0;

    int* ans = (int*)malloc(arrSize * 32 * sizeof(int));
    int ansSize = 0;
    
    int left = 0;
    int right = 0;

    for (int i = 0; i < arrSize; i++) {
        int start = ansSize;
        ans[ansSize++] = arr[i];

        for (int j = left; j < right; j++) {
            int val = ans[j] | arr[i];
            if (ans[ansSize - 1] != val) {
                ans[ansSize++] = val;
            }
        }

        left = start;
        right = ansSize;
    }

    qsort(ans, ansSize, sizeof(int), cmp);

    if (ansSize == 0) {
        free(ans);
        return 0;
    }

    int uniqueCount = 1;
    for (int i = 1; i < ansSize; i++) {
        if (ans[i] != ans[i - 1]) {
            uniqueCount++;
        }
    }

    free(ans);
    return uniqueCount;
}

